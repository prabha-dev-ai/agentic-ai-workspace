# Copy this file to .env and fill in the values you need.
#
# This is the complete list of environment variables the framework reads —
# every one of them is read in exactly one place, server/src/config/env.ts.
# Nothing else in the codebase touches process.env directly (enforced by
# server/src/core/architecture.test.ts).

# --- Server ---

# Node environment. Defaults to "development" if unset.
NODE_ENV=development

# HTTP port the Express server listens on. Defaults to 3000 if unset.
PORT=3000

# --- LLM ---

# Which provider you're pointing at. Informational only — defaults to
# "openrouter" if unset; the actual endpoint is LLM_BASE_URL below.
LLM_PROVIDER=openrouter

# Required to actually call a model (npm run build / npm test / the
# example script all work without it — the OpenAI client is constructed
# lazily and only resolved when something needs it).
LLM_API_KEY=

# The OpenAI-compatible base URL for chat completions.
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# NOTE: OpenRouter does not serve /embeddings. If you're using the
# default embedding provider (server/src/core/embeddings), point
# LLM_BASE_URL at an OpenAI-compatible endpoint that does serve it, or
# contribute an alternative embedding provider through the plugin
# platform (EmbeddingProvider capability).

# Model id to use for chat completions, e.g. "openai/gpt-4o-mini" on
# OpenRouter, or any model id your LLM_BASE_URL serves.
LLM_MODEL=

# --- Persistent storage (AAI-036, optional) ---
#
# Both are entirely optional. Leaving them unset gives you exactly
# v2.0.0's in-memory-only behavior — nothing else changes, no database or
# Redis server is required to build/test/run. See migrations/README.md
# for the schema these providers expect.

# Postgres connection string. When set, the shared vector store
# (TOKENS.vectorStore) switches from InMemoryVectorStore to
# PostgresVectorStore (pgvector), and the additive async checkpoint/
# knowledge-store providers become available (CheckpointManager.
# checkpointAsync()/recoverAsync(), TOKENS.asyncKnowledgeStore).
DATABASE_URL=

# Column width for the pgvector-backed vector store. Must match the
# embedding model in use (core/embeddings/EmbeddingModel.ts). Defaults to
# 1536 (text-embedding-3-small) if unset.
PG_VECTOR_DIMENSIONS=1536

# Redis connection string. When set, a Redis-backed AsyncCache named
# "redis" becomes available through CacheRegistry.getAsync('redis') —
# additive to the existing in-memory caches, nothing is replaced.
REDIS_URL=

# --- Gateway authentication & authorization (AAI-038, optional) ---
#
# Both API_KEYS and JWT_SECRET are entirely optional and independent.
# Leaving both unset gives you exactly AAI-037's behavior — every gateway
# route stays open, nothing to configure to start the server.

# Comma-separated "key:subject:role1|role2" entries, e.g.
#   API_KEYS=sk_live_abc123:alice:admin,sk_live_def456:bob:viewer
# Built-in roles (core/auth/Role.ts): admin (everything), operator
# (chat/agent/workflow read+write), viewer (read-only + diagnostics/metrics).
API_KEYS=

# HMAC secret for verifying (and, via JwtService.sign(), minting) HS256
# JWTs. When set, "Authorization: Bearer <jwt>" is accepted alongside API
# keys. Expected claims: "sub" (subject), "roles" (array or comma-separated
# string), optional "exp" (expiry, enforced if present) and "iss" (see
# JWT_ISSUER below).
JWT_SECRET=

# When set, a JWT whose "iss" claim doesn't match exactly is rejected.
# Optional even when JWT_SECRET is set.
JWT_ISSUER=

# --- Gateway rate limiting (AAI-038, optional) ---
#
# Both must be positive to enable rate limiting; either unset (or <= 0)
# disables it entirely. Keyed by the authenticated principal's subject, or
# the request IP when unauthenticated.

# Fixed-window size in milliseconds, e.g. 60000 for a one-minute window.
RATE_LIMIT_WINDOW_MS=

# Max requests allowed per key within one window.
RATE_LIMIT_MAX=
